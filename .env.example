# mcpforwork self-host configuration — copy to .env and edit.
# docker compose reads .env automatically.

# REQUIRED. Signs the magic-link session cookies (HMAC). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCPFORWORK_SESSION_SECRET=

# The local tenant's email. The MCP server writes as this user; log into the
# dashboard with THIS SAME address so both resolve the same account row.
# The default works out of the box for single-user self-host.
MCPFORWORK_USER_EMAIL=local@self-host

# --- optional overrides (defaults shown) -----------------------------------

# Where the browser lands after magic-link redeem.
# MCPFORWORK_POST_LOGIN_REDIRECT=http://localhost:2200/pipeline

# Set to 1 behind a TLS-terminating reverse proxy (default 0 = LAN http).
# MCPFORWORK_COOKIE_SECURE=0

# Host allowlist for the API (DNS-rebinding guard). `api` is the compose
# network name the web container uses; add your LAN hostname if you expose it.
# MCPFORWORK_ALLOWED_HOSTS=api,localhost,127.0.0.1

# Host port overrides to dodge collisions with other local stacks.
# WEB_PORT=2200
# API_PORT=8000
# MCP_PORT=8500
